local function AddTgl(parent, text, default, callback)
    local B = Instance.new("TextButton")
    B.Size, B.BackgroundColor3, B.Text, B.ZIndex = UDim2.new(1, -10, 0, 34), Theme.Elem, "", 53
    B.Parent = parent
    Instance.new("UICorner", B).CornerRadius = UDim.new(0, 6)
    local L = Instance.new("TextLabel")
    L.Size, L.Position, L.BackgroundTransparency, L.ZIndex = UDim2.new(1, -60, 1, 0), UDim2.new(0, 10, 0, 0), 1, 54
    L.Text, L.TextColor3, L.Font, L.TextSize, L.TextXAlignment = text, Theme.Text, Enum.Font.Gotham, 12, Enum.TextXAlignment.Left
    L.Parent = B
    local Track = Instance.new("Frame")
    Track.Size, Track.Position, Track.BackgroundColor3, Track.ZIndex = UDim2.new(0, 34, 0, 18), UDim2.new(1, -44, 0.5, -9), Color3.fromRGB(50, 50, 60), 54
    Track.Parent = B
    Instance.new("UICorner", Track).CornerRadius = UDim.new(1, 0)
    local Knob = Instance.new("Frame")
    Knob.Size, Knob.Position, Knob.BackgroundColor3, Knob.ZIndex = UDim2.new(0, 14, 0, 14), UDim2.new(0, 2, 0.5, -7), Theme.Text, 55
    Knob.Parent = Track
    Instance.new("UICorner", Knob).CornerRadius = UDim.new(1, 0)
    local State = default or false
    local function Update()
        if State then Track.BackgroundColor3 = Theme.Accent; Knob.Position = UDim2.new(1, -16, 0.5, -7)
        else Track.BackgroundColor3 = Color3.fromRGB(50, 50, 60); Knob.Position = UDim2.new(0, 2, 0.5, -7) end
    end
    if State then Update() end
    B.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then State = not State; Update(); pcall(function() callback(State) end) end end)
end

local function AddSld(parent, text, min, max, default, callback)
    local F = Instance.new("Frame")
    F.Size, F.BackgroundColor3, F.ZIndex = UDim2.new(1, -10, 0, 40), Theme.Elem, 53
    F.Parent = parent
    Instance.new("UICorner", F).CornerRadius = UDim.new(0, 6)
    local L = Instance.new("TextLabel")
    L.Size, L.Position, L.BackgroundTransparency, L.ZIndex = UDim2.new(1, -10, 0, 18), UDim2.new(0, 10, 0, 2), 1, 54
    L.Text, L.TextColor3, L.Font, L.TextSize, L.TextXAlignment = text .. ": " .. default, Theme.Text, Enum.Font.Gotham, 12, Enum.TextXAlignment.Left
    L.Parent = F
    local Bar = Instance.new("Frame")
    Bar.Size, Bar.Position, Bar.BackgroundColor3, Bar.ZIndex = UDim2.new(1, -20, 0, 4), UDim2.new(0, 10, 0, 28), Color3.fromRGB(50, 50, 60), 54
    Bar.Parent = F
    Instance.new("UICorner", Bar).CornerRadius = UDim.new(1, 0)
    local Fill = Instance.new("Frame")
    Fill.Size, Fill.BackgroundColor3, Fill.ZIndex = UDim2.new((default - min) / (max - min), 0, 1, 0), Theme.Accent, 55
    Fill.Parent = Bar
    local Drag = false
    local function Update(input)
        if Bar.AbsoluteSize.X <= 0 then return end
        local pct = math.clamp((input.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
        local val = min + (max - min) * pct
        val = math.floor(val * 100) / 100
        Fill.Size = UDim2.new(pct, 0, 1, 0)
        L.Text = text .. ": " .. val
        pcall(function() callback(val) end)
    end
    Bar.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then Drag = true; Update(i) end end)
    UserInputService.InputChanged:Connect(function(i) if Drag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then Update(i) end end)
    UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then Drag = false end end)
end

local drag, start, pos = false, nil, nil
