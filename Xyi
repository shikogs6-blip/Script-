local Tabs = {}
local function CreateTab(name, icon)
    local Btn = Instance.new("TextButton")
    Btn.Size, Btn.BackgroundColor3, Btn.ZIndex = UDim2.new(1, -10, 0, 34), Theme.Side, 53
    Btn.Text, Btn.TextColor3 = "  " .. icon .. "  " .. name, Theme.Sub
    Btn.Font, Btn.TextSize, Btn.TextXAlignment = Enum.Font.GothamSemibold, 12, Enum.TextXAlignment.Left
    Btn.Parent = Sidebar
    Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 6)
    
    local Frame = Instance.new("ScrollingFrame")
    Frame.Size, Frame.BackgroundTransparency, Frame.BorderSizePixel = UDim2.new(1, 0, 1, 0), 1, 0
    Frame.ScrollBarThickness, Frame.Visible, Frame.ZIndex = 3, false, 52
    Frame.Parent = Content
    local Layout = Instance.new("UIListLayout")
    Layout.Padding = UDim.new(0, 6); Layout.Parent = Frame
    Layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function() Frame.CanvasSize = UDim2.new(0, 0, 0, Layout.AbsoluteContentSize.Y + 20) end)
    
    Tabs[name] = { Btn = Btn, Frame = Frame }
    Btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            for _, t in pairs(Tabs) do t.Btn.BackgroundColor3 = Theme.Side; t.Btn.TextColor3 = Theme.Sub; t.Frame.Visible = false end
            Btn.BackgroundColor3 = Theme.Elem; Btn.TextColor3 = Theme.Text; Frame.Visible = true
        end
    end)
    return Frame
end

