local function SetSky(name)
    local d = Skies[name]
    if not d then return end
    local s = Lighting:FindFirstChild("Nebesny_Sky") or Instance.new("Sky", Lighting)
    s.Name = "Nebesny_Sky"
    s.SkyboxBk = d.Bk; s.SkyboxDn = d.Dn; s.SkyboxFt = d.Ft
    s.SkyboxLf = d.Lf; s.SkyboxRt = d.Rt; s.SkyboxUp = d.Up
end
local function ResetSky()
    local s = Lighting:FindFirstChild("Nebesny_Sky")
    if s then s:Destroy() end
end

-- Логика Воды (Ищет Terrain и части)
local function WaterAction(action, color)
    local t = Workspace:FindFirstChildOfClass("Terrain")
    if t then
        if action == "remove" then t.WaterTransparency = 1; t.WaterWaveSize = 0
        elseif action == "restore" then t.WaterTransparency = 0.3; t.WaterWaveSize = 0.15
        elseif action == "color" then t.WaterColor = color; t.WaterTransparency = 0.3 end
    end
    task.spawn(function()
        for _, o in ipairs(Workspace:GetDescendants()) do
            if o:IsA("BasePart") and o ~= t then
                local n = string.lower(o.Name)
                if o.Material == Enum.Material.Water or string.find(n, "water") or string.find(n, "ocean") then
                    if action == "remove" then o.Transparency = 1
                    elseif action == "restore" then o.Transparency = 0.5
                    elseif action == "color" then o.Color = color; o.Transparency = 0.5 end
                end
            end
        end
    end)
end

