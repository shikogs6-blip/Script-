local function SetSky(name)
    local d = Skies[name]; if not d then return end
    local s = Lighting:FindFirstChild("Nebesny_Sky") or Instance.new("Sky", Lighting)
    s.Name = "Nebesny_Sky"; s.SkyboxBk = d.Bk; s.SkyboxDn = d.Dn; s.SkyboxFt = d.Ft; s.SkyboxLf = d.Lf; s.SkyboxRt = d.Rt; s.SkyboxUp = d.Up
end
