    Knob.Parent = Track
    Instance.new("UICorner", Knob).CornerRadius = UDim.new(1, 0)
    local State = default or false
    local function UpdateVisual()
        if State then Track.BackgroundColor3 = Theme.Accent; Knob.Position = UDim2.new(1, -16, 0.5, -7)
        else Track.BackgroundColor3 = Color3.fromRGB(50, 50, 60); Knob.Position = UDim2.new(0, 2, 0.5, -7) end
    end
    if State then UpdateVisual() end
    Btn.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            State = not State; UpdateVisual(); pcall(function() callback(State) end)
        end
    end)
    Btn.Set = function(val) State = val; UpdateVisual(); pcall(function() callback(State) end) end
    return Btn
end

local function AddSld(parent, text, min, max, default, callback)
    local Frame = Instance.new("Frame")
    Frame.Size, Frame.BackgroundColor3, Frame.ZIndex = UDim2.new(1, -10, 0, 44), Theme.Elem, 53
    Frame.Parent = parent
    Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 6)
    local Label = Instance.new("TextLabel")
    Label.Size, Label.Position, Label.BackgroundTransparency = UDim2.new(1, -20, 0, 18), UDim2.new(0, 10, 0, 4), 1
    Label.Text, Label.TextColor3, Label.Font, Label.TextSize, Label.TextXAlignment = text .. ": " .. tostring(default), Theme.Text, Enum.Font.Gotham, 12, Enum.TextXAlignment.Left
    Label.Parent = Frame
    local Bar = Instance.new("Frame")
    Bar.Size, Bar.Position, Bar.BackgroundColor3 = UDim2.new(1, -20, 0, 4), UDim2.new(0, 10, 0, 28), Color3.fromRGB(50, 50, 60)
    Bar.Parent = Frame
    Instance.new("UICorner", Bar).CornerRadius = UDim.new(1, 0)
    local Fill = Instance.new("Frame")
    Fill.Size, Fill.BackgroundColor3 = UDim2.new((default - min) / (max - min), 0, 1, 0), Theme.Accent
    Fill.Parent = Bar
    Instance.new("UICorner", Fill).CornerRadius = UDim.new(1, 0)
    local Knob = Instance.new("Frame")
    Knob.Size, Knob.Position, Knob.BackgroundColor3 = UDim2.new(0, 10, 0, 10), UDim2.new((default - min) / (max - min), -5, 0.5, -5), Theme.Text
    Knob.Parent = Bar
    Instance.new("UICorner", Knob).CornerRadius = UDim.new(1, 0)
    local Dragging = false
    local function Update(input)
        if Bar.AbsoluteSize.X <= 0 then return end
        local relX = math.clamp(input.Position.X - Bar.AbsolutePosition.X, 0, Bar.AbsoluteSize.X)
        local percent = relX / Bar.AbsoluteSize.X
        local value = math.floor(min + (max - min) * percent)
        Fill.Size = UDim2.new(percent, 0, 1, 0); Knob.Position = UDim2.new(percent, -5, 0.5, -5); Label.Text = text .. ": " .. tostring(value)
        pcall(function() callback(value) end)
    end
    Bar.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then Dragging = true; Update(i) end end)
    UserInputService.InputChanged:Connect(function(i) if Dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then Update(i) end end)
    UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then Dragging = false end end)
    Frame.Set = function(val) local pc = (val - min) / (max - min); Fill.Size = UDim2.new(pc, 0, 1, 0); Knob.Position = UDim2.new(pc, -5, 0.5, -5); Label.Text = text .. ": " .. tostring(val); pcall(function() callback(val) end) end
    return Frame
end

