local function Drag(Part, Target)
    local Drg, Start, StartPos = false, nil, nil
    Part.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then Drg = true; Start = i.Position; StartPos = Target.Position end end)
