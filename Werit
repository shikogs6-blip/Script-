    RunService.RenderStepped:Connect(function() f = f + 1; if tick() - l >= 1 then Fps.Text = "FPS: " .. f; f = 0; l = tick() end end)
    task.spawn(function() while task.wait(1) do pcall(function() Ping.Text = "Ping: " .. math.floor(game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue()) end) end end)
end)
