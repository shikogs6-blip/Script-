    local StatsGui = Instance.new("ScreenGui", PlayerGui)
    StatsGui.Name = "NebesnyStats"
    local Fps, Ping = Instance.new("TextLabel", StatsGui), Instance.new("TextLabel", StatsGui)
    Fps.Size, Fps.Position, Fps.TextColor3, Fps.BackgroundTransparency = UDim2.new(0, 100, 0, 20), UDim2.new(0, 10, 0, 40), Accent, 1
    Ping.Size, Ping.Position, Ping.TextColor3, Ping.BackgroundTransparency = UDim2.new(0, 100, 0, 20), UDim2.new(0, 10, 0, 60), TextColor, 1
    Fps.Text, Ping.Text, Fps.Font, Ping.Font = "FPS: 60", "Ping: 0", Enum.Font.GothamBold, Enum.Font.GothamBold
    Fps.Parent, Ping.Parent = StatsGui, StatsGui
