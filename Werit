local Tabs = {}
local function CreateTab(name)
    local Btn = Instance.new("TextButton")
    Btn.Size, Btn.BackgroundColor3, Btn.Text, Btn.TextColor3 = UDim2.new(1, -10, 0, 30), Theme.Side, "  " .. name, Theme.Sub
    Btn.Font, Btn.TextSize, Btn.TextXAlignment = Enum.Font.GothamSemibold, 12, Enum.TextXAlignment.Left
    Btn.Parent = Sidebar
    Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 6)
    
    local Frame = Instance.new("ScrollingFrame")
    Frame.Size, Frame.BackgroundTransparency, Frame.BorderSizePixel = UDim2.new(1, 0, 1, 0), 1, 0
    Frame.ScrollBarThickness, Frame.Visible, Frame.ZIndex = 3, false, 52
    Frame.Parent = Content
    local Layout = Instance.new("UIListLayout")
    Layout.Padding = UDim.new(0, 5); Layout.Parent = Frame
    Layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function() Frame.CanvasSize = UDim2.new(0, 0, 0, Layout.AbsoluteContentSize.Y + 15) end)
    
    Tabs[name] = { Btn = Btn, Frame = Frame }
    Btn.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            for _, t in pairs(Tabs) do t.Btn.BackgroundColor3 = Theme.Side; t.Btn.TextColor3 = Theme.Sub; t.Frame.Visible = false end
            Btn.BackgroundColor3 = Theme.Elem; Btn.TextColor3 = Theme.Text; Frame.Visible = true
        end
    end)
    return Frame
end

local function AddBtn(parent, text, callback)
    local Btn = Instance.new("TextButton")
    Btn.Size, Btn.BackgroundColor3, Btn.Text, Btn.TextColor3 = UDim2.new(1, -10, 0, 28), Theme.Elem, text, Theme.Text
    Btn.Font, Btn.TextSize, Btn.ZIndex = Enum.Font.Gotham, 12, 53
    Btn.Parent = parent
    Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 6)
    Btn.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then pcall(callback) end end)
end

local function AddSld(parent, text, min, max, default, callback)
    local Frame = Instance.new("Frame")
    Frame.Size, Frame.BackgroundColor3, Frame.ZIndex = UDim2.new(1, -10, 0, 40), Theme.Elem, 53
    Frame.Parent = parent
    Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 6)
    local Label = Instance.new("TextLabel")
    Label.Size, Label.Position, Label.BackgroundTransparency = UDim2.new(1, -10, 0, 16), UDim2.new(0, 10, 0, 2), 1
    Label.Text, Label.TextColor3, Label.Font, Label.TextSize, Label.TextXAlignment = text .. ": " .. tostring(default), Theme.Text, Enum.Font.Gotham, 11, Enum.TextXAlignment.Left
    Label.Parent = Frame
    local Bar = Instance.new("Frame")
    Bar.Size, Bar.Position, Bar.BackgroundColor3 = UDim2.new(1, -20, 0, 4), UDim2.new(0, 10, 0, 24), Color3.fromRGB(50, 50, 60)
    Bar.Parent = Frame
    Instance.new("UICorner", Bar).CornerRadius = UDim.new(1, 0)
    local Fill = Instance.new("Frame")
    Fill.Size, Fill.BackgroundColor3 = UDim2.new((default - min) / (max - min), 0, 1, 0), Theme.Accent
    Fill.Parent = Bar
    local Knob = Instance.new("Frame")
    Knob.Size, Knob.Position, Knob.BackgroundColor3 = UDim2.new(0, 8, 0, 8), UDim2.new((default - min) / (max - min), -4, 0.5, -4), Theme.Text
    Knob.Parent = Bar
    Instance.new("UICorner", Knob).CornerRadius = UDim.new(1, 0)
    local Dragging = false
    local function Update(input)
        if Bar.AbsoluteSize.X <= 0 then return end
        local relX = math.clamp(input.Position.X - Bar.AbsolutePosition.X, 0, Bar.AbsoluteSize.X)
        local percent = relX / Bar.AbsoluteSize.X
        local value = math.floor(min + (max - min) * percent)
        Fill.Size = UDim2.new(percent, 0, 1, 0); Knob.Position = UDim2.new(percent, -4, 0.5, -4); Label.Text = text .. ": " .. tostring(value)
        pcall(function() callback(value) end)
    end
    Bar.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then Dragging = true; Update(i) end end)
    UserInputService.InputChanged:Connect(function(i) if Dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then Update(i) end end)
    UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then Dragging = false end end)
end

local function Drag(Part, Target)
    local Drg, Start, StartPos = false, nil, nil
    Part.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then Drg = true; Start = i.Position; StartPos = Target.Position end end)
    UserInputService.InputChanged:Connect(function(i) if Drg and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then local d = i.Position - Start; Target.Position = UDim2.new(StartPos.X.Scale, StartPos.X.Offset + d.X, StartPos.Y.Scale, StartPos.Y.Offset + d.Y) end end)
    UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then Drg = false end end)
end
