-- ХЕЛПЕРЫ
local function AddLbl(text)
    local L = Instance.new("TextLabel")
    L.Size, L.BackgroundTransparency, L.Text = UDim2.new(1, 0, 0, 18), 1, text
    L.TextColor3, L.Font, L.TextSize, L.TextXAlignment = Theme.Sub, Enum.Font.GothamBold, 11, Enum.TextXAlignment.Left
    L.Parent = Scroll
end

local function AddBtn(text, callback)
    local B = Instance.new("TextButton")
    B.Size, B.BackgroundColor3, B.Text, B.TextColor3 = UDim2.new(1, 0, 0, 30), Theme.Elem, text, Theme.Text
    B.Font, B.TextSize = Enum.Font.Gotham, 12
    B.Parent = Scroll
    Instance.new("UICorner", B).CornerRadius = UDim.new(0, 6)
    B.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then pcall(callback) end end)
end

local function AddSld(text, min, max, default, callback)
    local F = Instance.new("Frame")
    F.Size, F.BackgroundColor3 = UDim2.new(1, 0, 0, 40), Theme.Elem
    F.Parent = Scroll
    Instance.new("UICorner", F).CornerRadius = UDim.new(0, 6)
    local L = Instance.new("TextLabel")
    L.Size, L.Position, L.BackgroundTransparency = UDim2.new(1, -10, 0, 18), UDim2.new(0, 10, 0, 2), 1
    L.Text, L.TextColor3, L.Font, L.TextSize, L.TextXAlignment = text .. ": " .. default, Theme.Text, Enum.Font.Gotham, 12, Enum.TextXAlignment.Left
    L.Parent = F
    local Bar = Instance.new("Frame")
    Bar.Size, Bar.Position, Bar.BackgroundColor3 = UDim2.new(1, -20, 0, 4), UDim2.new(0, 10, 0, 28), Color3.fromRGB(50, 50, 60)
    Bar.Parent = F
    Instance.new("UICorner", Bar).CornerRadius = UDim.new(1, 0)
    local Fill = Instance.new("Frame")
    Fill.Size, Fill.BackgroundColor3 = UDim2.new((default - min) / (max - min), 0, 1, 0), Theme.Accent
    Fill.Parent = Bar
    local Drag = false
    local function Update(input)
        if Bar.AbsoluteSize.X <= 0 then return end
        local pct = math.clamp((input.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
        local val = math.floor(min + (max - min) * pct)
        Fill.Size = UDim2.new(pct, 0, 1, 0)
        L.Text = text .. ": " .. val
        pcall(function() callback(val) end)
    end
    Bar.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then Drag = true; Update(i) end end)
    UserInputService.InputChanged:Connect(function(i) if Drag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then Update(i) end end)
    UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then Drag = false end end)
end

-- ФУНКЦИИ
local function ApplyFOV() if Workspace.CurrentCamera then Workspace.CurrentCamera.FieldOfView = Settings.FOV * (Settings.Stretch / 100) end end

local function SetSky(id)
    local s = Lighting:FindFirstChild("Sky") or Instance.new("Sky", Lighting)
    if type(id) == "table" then
        s.SkyboxBk, s.SkyboxDn, s.SkyboxFt, s.SkyboxLf, s.SkyboxRt, s.SkyboxUp = id[1], id[2], id[3], id[4], id[5], id[6]
    else
        s.SkyboxBk, s.SkyboxDn, s.SkyboxFt, s.SkyboxLf, s.SkyboxRt, s.SkyboxUp = id, id, id, id, id, id
    end
end

local function WaterAction(action, color)
    local t = Workspace:FindFirstChildOfClass("Terrain")
    if t then
        if action == "remove" then t.WaterTransparency = 1; t.WaterWaveSize = 0
        elseif action == "restore" then t.WaterTransparency = 0.3; t.WaterWaveSize = 0.15
        elseif action == "color" then t.WaterColor = color; t.WaterTransparency = 0.3 end
    end
end

