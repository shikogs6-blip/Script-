-- ХЕЛПЕРЫ (Абсолютное позиционирование)
local yPos = 45

local function AddBtn(text, callback)
    local Btn = Instance.new("TextButton")
    Btn.Size, Btn.Position, Btn.BackgroundColor3 = UDim2.new(1, -20, 0, 30), UDim2.new(0, 10, 0, yPos), BtnColor
    Btn.Text, Btn.TextColor3, Btn.Font, Btn.TextSize = text, TextColor, Enum.Font.Gotham, 12
    Btn.Parent = Main
    Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, 6)
    Btn.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then pcall(callback) end end)
    yPos = yPos + 35
end

local function AddSld(text, min, max, default, callback)
    local Frame = Instance.new("Frame")
    Frame.Size, Frame.Position, Frame.BackgroundColor3 = UDim2.new(1, -20, 0, 40), UDim2.new(0, 10, 0, yPos), BtnColor
    Frame.Parent = Main
    Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 6)
    
    local Lbl = Instance.new("TextLabel")
    Lbl.Size, Lbl.Position, Lbl.BackgroundTransparency = UDim2.new(1, -10, 0, 20), UDim2.new(0, 5, 0, 2), 1
    Lbl.Text, Lbl.TextColor3, Lbl.Font, Lbl.TextSize, Lbl.TextXAlignment = text .. ": " .. default, TextColor, Enum.Font.Gotham, 12, Enum.TextXAlignment.Left
    Lbl.Parent = Frame
    
    local Bar = Instance.new("Frame")
    Bar.Size, Bar.Position, Bar.BackgroundColor3 = UDim2.new(1, -20, 0, 4), UDim2.new(0, 10, 0, 28), Color3.fromRGB(50, 50, 60)
    Bar.Parent = Frame
    Instance.new("UICorner", Bar).CornerRadius = UDim.new(1, 0)
    
    local Fill = Instance.new("Frame")
    Fill.Size, Fill.BackgroundColor3 = UDim2.new((default - min) / (max - min), 0, 1, 0), Accent
    Fill.Parent = Bar
    
    local Drag = false
    local function Update(input)
        if Bar.AbsoluteSize.X <= 0 then return end
        local pct = math.clamp((input.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
        local val = math.floor(min + (max - min) * pct)
        Fill.Size = UDim2.new(pct, 0, 1, 0)
        Lbl.Text = text .. ": " .. val
        pcall(function() callback(val) end)
    end
    
    Bar.InputBegan:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then Drag = true; Update(i) end end)
    UserInputService.InputChanged:Connect(function(i) if Drag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then Update(i) end end)
    UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then Drag = false end end)
    
    yPos = yPos + 45
end

